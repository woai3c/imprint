# Imprint 环境变量示例
#
# 用途：
# 1. 基准测试在线档（pnpm test:benchmark:live）从此文件读取已配置的供应商；
# 2. CLI（imprint extract --intelligence ...）和 MCP（imprint_interpret）读取同名的进程环境变量。
#
# 注意：
# - 桌面应用的 AI 配置保存在应用设置（userData）中，与此文件完全无关，不会冲突；
# - Node 不会自动加载 .env，CLI/MCP 只认真实的环境变量（可用 setx / export 设置，或复制此文件后自行加载）；
# - 进程环境变量优先于此文件中的同名变量；
# - 真实 .env 已被 gitignore，永远不要提交真实密钥。

# 通用覆盖：设置后优先于下方所有供应商专属 key（provider=custom 时必须搭配 IMPRINT_AI_BASE_URL）
# IMPRINT_AI_API_KEY=
# IMPRINT_AI_BASE_URL=
# IMPRINT_AI_MODEL=

# 各供应商标准 key（与 CLI/MCP 约定一致，设置哪个就在基准测试中选择哪个）
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=
# ALIBABA_API_KEY=
# ZHIPU_API_KEY=
# XAI_API_KEY=

# 基准测试可选的每供应商覆盖（前缀与上方 key 一致）
# OPENAI_MODEL=
# OPENAI_BASE_URL=
# DEEPSEEK_MODEL=
# DEEPSEEK_BASE_URL=
