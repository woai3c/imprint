{
  "name": "imprint",
  "productName": "Imprint",
  "version": "0.0.1",
  "description": "Extract website UI design styles and export as CSS/Tailwind themes for AI to use",
  "author": "woai3c",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woai3c/imprint.git"
  },
  "main": ".vite/build/index.js",
  "private": true,
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "electron-forge start",
    "build": "electron-forge package",
    "build:cli": "tsc -p tsconfig.cli.json",
    "make": "electron-forge make",
    "test:e2e": "pnpm build && node --test tests/e2e/core-flow.test.mjs",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "ci": "pnpm typecheck && pnpm lint && pnpm build",
    "release": "node scripts/release.mjs",
    "release:check": "pnpm typecheck && pnpm exec eslint . && pnpm format:check",
    "release:verify": "node scripts/verify-release.mjs",
    "release:notes": "node scripts/extract-release-notes.mjs",
    "release:collect": "node scripts/collect-release-artifacts.mjs",
    "prepare": "husky"
  },
  "bin": {
    "imprint": "./dist/cli/index.js",
    "imprint-mcp": "./dist/mcp/server.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "i18next": "^26.3.6",
    "playwright-core": "^1.50.0",
    "react-i18next": "^17.0.11",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@electron-forge/cli": "^7.0.0",
    "@electron-forge/maker-dmg": "^7.0.0",
    "@electron-forge/maker-squirrel": "^7.0.0",
    "@electron-forge/plugin-vite": "^7.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.0",
    "@types/better-sqlite3": "^7.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.0.0",
    "electron": "^34.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.0.0",
    "lint-staged": "^16.0.0",
    "lucide-react": "^0.500.0",
    "prettier": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "zustand": "^5.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,mjs}": [
      "prettier --write"
    ],
    "*.{json,md,yaml,css}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "appdmg",
      "better-sqlite3",
      "ds-store",
      "electron",
      "electron-winstaller",
      "esbuild",
      "fs-xattr",
      "macos-alias"
    ]
  }
}
