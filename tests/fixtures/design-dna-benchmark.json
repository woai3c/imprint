{
  "schemaVersion": "1",
  "description": "Local benchmark descriptors for deterministic evidence and DesignProfile regression tests. No third-party assets are bundled.",
  "annotationLegend": {
    "family": "Human-labelled content and product topology family.",
    "viewports": "Required deterministic capture coverage.",
    "traits": "Human-labelled signature structure, media, density, or interaction observations. Each case must preserve at least two traits in transfer rules and cite their source evidence.",
    "safeInteractionExpectation": "Fixtures in an interactive family must expose only restorable tabs, disclosures, dialogs, or passive CSS states."
  },
  "artifactExpectations": {
    "evidence-only": ["topology", "sections", "components", "coverage", "limitations"],
    "structural-ai": ["thesis", "signatureMoves", "transferRules", "agentContext"],
    "multimodal-ai": ["visualLanguage", "attention", "regionEvidence", "uncertainties"]
  },
  "reviewRubric": [
    "groundedness",
    "specificity",
    "executability",
    "transferability",
    "distinctiveness",
    "restraint",
    "safety"
  ],
