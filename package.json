{
  "name": "imprint",
  "productName": "Imprint",
  "version": "0.1.2",
  "description": "Extract visual languages from websites and generate reusable design systems for AI",
  "author": "woai3c",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woai3c/imprint.git"
  },
  "main": ".vite/build/index.js",
  "private": true,
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "electron-forge start",
    "predev": "pnpm browser:install",
    "build": "electron-forge package",
    "prebuild": "pnpm browser:install",
    "prebuild:cli": "node scripts/clean-cli-dist.mjs",
    "build:cli": "tsc -p tsconfig.cli.json",
    "make": "electron-forge make",
    "premake": "pnpm browser:install",
    "browser:install": "node scripts/install-headless-browser.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build && pnpm test:packaged && pnpm build:cli && pnpm exec electron-rebuild --force --only better-sqlite3 && node --test --test-concurrency=1 tests/e2e/*.test.mjs",
    "test:packaged": "node scripts/smoke-test-packaged-app.mjs",
    "test:all": "pnpm test && pnpm test:e2e",
    "test:comparison-site": "node tests/comparison-site/server.mjs",
    "prebenchmark:comparison": "pnpm build:cli",
    "benchmark:comparison": "node scripts/comparison-benchmark.mjs",
    "benchmark:comparison:prospective": "pnpm build:cli && node scripts/comparison-benchmark.mjs --corpus tests/comparison-benchmark/corpus/prospective-v3.json --policy tests/comparison-benchmark/policies/desktop-p0-prospective-v3.json",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "ci": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "release": "node scripts/release.mjs",
    "release:check": "pnpm typecheck && pnpm exec eslint . && pnpm format:check",
    "release:verify": "node scripts/verify-release.mjs",
    "release:notes": "node scripts/extract-release-notes.mjs",
    "release:collect": "node scripts/collect-release-artifacts.mjs",
    "prepare": "husky",
    "test:design-evidence": "vitest run -c vitest.design-evidence.config.ts",
    "pretest:live-corpus": "pnpm build:cli",
    "test:live-corpus": "node scripts/live-corpus.mjs",
    "audit:design-doc": "node scripts/audit-design-doc.mjs"
  },
  "bin": {
    "imprint": "./dist/cli/index.js",
    "imprint-mcp": "./dist/mcp/server.js"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "better-sqlite3": "^11.0.0",
    "i18next": "^26.3.6",
    "playwright-core": "^1.50.0",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@electron-forge/cli": "^7.0.0",
    "@electron-forge/maker-dmg": "^7.0.0",
    "@electron-forge/maker-zip": "^7.0.0",
    "@electron-forge/plugin-vite": "^7.0.0",
    "@electron/rebuild": "^3.7.2",
    "@google/design.md": "0.4.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@tailwindcss/vite": "^4.0.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.0",
    "@types/better-sqlite3": "^7.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "4.1.10",
    "electron": "^34.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.0.0",
    "lint-staged": "^16.0.0",
    "lucide-react": "^0.500.0",
    "prettier": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "4.1.10",
    "zustand": "^5.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,mjs}": [
      "prettier --write"
    ],
    "*.{json,md,yaml,css}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "appdmg",
      "better-sqlite3",
      "ds-store",
      "electron",
      "electron-winstaller",
      "esbuild",
      "fs-xattr",
      "macos-alias"
    ]
  }
}
